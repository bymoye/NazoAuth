# Git metadata is not needed inside image builds.
.git/

# Build and runtime output should never enter the Docker context.
target/*
!target/release-container/
target/release-container/*
!target/release-container/amd64/
!target/release-container/arm64/
target/release-container/amd64/*
target/release-container/arm64/*
!target/release-container/amd64/nazoauth
!target/release-container/arm64/nazoauth
runtime/
perf/results/

# Local-only environment and editor files.
.env
.env.*
!.env.yaml.example
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini
