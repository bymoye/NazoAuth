{
  "schema": 2,
  "repository": "nazozero/NazoAuth",
  "backup_root": "/opt/nazo-oauth/backups",
  "deployment_root": "/opt/nazo-oauth/deployments",
  "operator": {
    "deployment_id": "deployment-example",
    "controller_key_id": "controller-example",
    "controller_private_key": "/etc/nazoauth/operator/controller.key",
    "controller_public_key": "/etc/nazoauth/operator/controller.pub",
    "receipt_key_id": "receipt-example",
    "receipt_private_key": "/etc/nazoauth/operator/receipt.key",
    "receipt_public_key": "/etc/nazoauth/operator/receipt.pub",
    "audit_key_id": "audit-example",
    "audit_private_key": "/etc/nazoauth/operator/audit.key",
    "audit_public_key": "/etc/nazoauth/operator/audit.pub",
    "break_glass_key_id": "break-glass-example",
    "break_glass_private_key": "/etc/nazoauth/operator/break-glass.key",
    "break_glass_public_key": "/etc/nazoauth/operator/break-glass.pub",
    "secret_revision_file": "/etc/nazoauth/operator/secret-revision",
    "state_directory": "/opt/nazo-oauth/app/operator-state",
    "audit_directory": "/opt/nazo-oauth/audit",
    "trust_state_file": "/etc/nazoauth/operator/release-trust.json"
  },
  "dependencies": {
    "mode": "managed",
    "database_url_file": "",
    "migration_database_url_file": "",
    "valkey_url_file": ""
  },
  "runtime": {
    "engine": "podman",
    "container_name": "nazo-oauth-server",
    "network": "nazo_oauth_net",
    "ip_address": "10.101.0.20",
    "publish_address": "",
    "health_url": "http://10.101.0.20:8000/ready",
    "readiness_attempts": 60,
    "readiness_interval_seconds": 1,
    "public_discovery_url": "https://auth.example.com/.well-known/openid-configuration",
    "expected_issuer": "https://auth.example.com",
    "mounts": [
      {
        "source": "/opt/nazo-oauth/.env.yaml",
        "target": "/app/.env.yaml",
        "mode": "ro"
      },
      {
        "source": "/opt/nazo-oauth/runtime/keys",
        "target": "/var/lib/nazo_oauth/keys",
        "mode": "rw"
      },
      {
        "source": "/opt/nazo-oauth/runtime/avatars",
        "target": "/var/lib/nazo_oauth/avatars",
        "mode": "rw"
      }
    ],
    "snapshot_paths": [
      "/opt/nazo-oauth/runtime/keys"
    ],
    "environment": {}
  },
  "postgres": {
    "container_name": "nazo-oauth-postgres",
    "database": "oauth",
    "user": "nazoauth",
    "image": "docker.io/library/postgres:18@sha256:06cad38a5d9f5d24b4d83d86def30795d5e4b757fedbf5281172b576dedcd941",
    "validation_image": "docker.io/library/postgres:18@sha256:06cad38a5d9f5d24b4d83d86def30795d5e4b757fedbf5281172b576dedcd941"
  },
  "valkey": {
    "container_name": "nazo-oauth-valkey",
    "image": "docker.io/valkey/valkey:8-alpine@sha256:e0eb7c480958d32bdc4357a74bdd70653ae15f2f9b4c93c4a5a9fad1dc471c84",
    "rdb_path": "/data/dump.rdb",
    "password_file": ""
  },
  "ui": {
    "active_path": "/usr/local/angie/html/auth/ui",
    "releases_root": "/usr/local/angie/html/auth-releases",
    "serve_from_application": false
  }
}
